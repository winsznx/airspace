+
+// Fill queries scoped to a MARKET, not just a pool.
+//
+// The SDK's `getFills(pool, opts)` and `getUserFills(account, { pool })` scope by
+// pool address and apply `limit` to that result. On event contracts a binary pool
+// is RECYCLED across successive markets, so one pool address carries the tape of
+// every market that has ever run on it. The SDK's own `FillRow.market` docs say
+// so plainly: "Group and label by this, never by `pool` alone."
+//
+// But `FillsOptions` has no market filter, so the limit is applied before any
+// market scoping can happen. Measured against the live testnet indexer on
+// 2026-08-28, one 50-row page from a single recycled pool
+// (0xc09e4a5bdee2899962727125fb5eaeb896798e46) spanned THIRTEEN market
+// generations, of which four rows belonged to the market being asked about. A
+// caller that pages by 50 and filters client-side cannot tell a market's short
+// tape from a truncated one.
+//
+// These helpers push `market_id` into the server-side `where`, so `limit` means
+// "the last N fills in THIS market". Same indexer, same row shape, same ordering.
+//
+// Reported upstream against @somnia-chain/markets-sdk; kept here so kit users
+// have a correct path today.
+
+import type { FillRow } from "@somnia-chain/markets-sdk";
+
+/** Paging and time window, mirroring the SDK's `FillsOptions`. */
+export interface MarketFillsOptions {
+  /** Max rows (default 50). */
+  limit?: number;
+  /** Row offset for paging the tape (default 0). */
+  offset?: number;
+  /** Only fills at/after this unix-seconds timestamp. */
+  since?: number;
+  /** Only fills at/before this unix-seconds timestamp. */
+  until?: number;
+}
+
+const FILL_FIELDS = `
+  id
+  market: market_id
+  pool
+  fillPrice
+  quantity
+  quoteQuantity
+  maker
+  makerSide
+  taker
+  takerSide
+  kind
+  takerIsBid
+  timestamp
+  txHash
+  takerOrder { owner side }
+`;
+
+type Where = Record<string, unknown>;
+
+const applyWindow = (where: Where, o: MarketFillsOptions): Where => {
+  if (o.since != null || o.until != null) {
+    const ts: Record<string, string> = {};
+    if (o.since != null) ts._gte = String(o.since);
+    if (o.until != null) ts._lte = String(o.until);
+    where.timestamp = ts;
+  }
+  return where;
+};
+
+async function query(indexerUrl: string, where: Where, o: MarketFillsOptions): Promise<FillRow[]> {
+  const res = await fetch(indexerUrl, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({
+      query: `query MarketFills($where: Fill_bool_exp!, $limit: Int!, $offset: Int!) {
+        Fill(where: $where, order_by: { timestamp: desc }, limit: $limit, offset: $offset) {${FILL_FIELDS}}
+      }`,
+      variables: { where, limit: o.limit ?? 50, offset: o.offset ?? 0 },
+    }),
+  });
+
+  const body = (await res.json()) as { data?: { Fill: FillRow[] }; errors?: unknown[] };
+  // An empty array means "no fills". A failed read must never look like one.
+  if (body.errors?.length) throw new Error(`indexer: ${JSON.stringify(body.errors).slice(0, 300)}`);
+  return body.data?.Fill ?? [];
+}
+
+/**
+ * Recent fills for ONE market, newest first.
+ *
+ * `marketId` is the market's stable bytes32 id (`UnifiedMarket.info.marketId`,
+ * or `FillRow.market`), NOT a pool address. Unlike `getFills(pool, …)` the limit
+ * applies after market scoping, so a page of 50 is 50 fills in this market.
+ */
+export const getMarketFills = (
+  marketId: string,
+  opts: MarketFillsOptions,
+  indexerUrl: string,
+): Promise<FillRow[]> => query(indexerUrl, applyWindow({ market_id: { _eq: marketId } }, opts), opts);
+
+/**
+ * Fills `account` participated in (as maker OR taker) within ONE market.
+ *
+ * The three ways an account appears on a fill: as the maker, as the denormalized
+ * taker, or as the owner of the taker's order. The last is authoritative on
+ * binary markets, where `takerSide` is backfilled and can still be null on a row
+ * whose taker is already stamped.
+ */
+export const getMarketUserFills = (
+  account: string,
+  marketId: string,
+  opts: MarketFillsOptions,
+  indexerUrl: string,
+): Promise<FillRow[]> => {
+  const acct = account.toLowerCase();
+  return query(
+    indexerUrl,
+    applyWindow(
+      {
+        market_id: { _eq: marketId },
+        _or: [{ maker: { _eq: acct } }, { taker: { _eq: acct } }, { takerOrder: { owner: { _eq: acct } } }],
+      },
+      opts,
+    ),
+    opts,
+  );
+};
+
+/**
+ * Every fill in a market, paged until the tape runs out.
+ *
+ * `maxRows` is a guard, not a target: a long-running market can have a large
+ * tape and an unbounded loop against a public indexer is not a kindness. When
+ * the cap is reached the result is truncated, and the caller is told which by
+ * comparing `rows.length` to `maxRows`.
+ */
+export async function getAllMarketFills(
+  marketId: string,
+  indexerUrl: string,
+  opts: { pageSize?: number; maxRows?: number; since?: number; until?: number } = {},
+): Promise<FillRow[]> {
+  const pageSize = Math.min(opts.pageSize ?? 200, 1000);
+  const maxRows = opts.maxRows ?? 5_000;
+  const out: FillRow[] = [];
+
+  for (let offset = 0; out.length < maxRows; offset += pageSize) {
+    const page = await getMarketFills(
+      marketId,
+      { limit: Math.min(pageSize, maxRows - out.length), offset, ...(opts.since != null ? { since: opts.since } : {}), ...(opts.until != null ? { until: opts.until } : {}) },
+      indexerUrl,
+    );
+    out.push(...page);
+    if (page.length < pageSize) break;
+  }
+  return out;
+}
