# ---------------------------------------------------------------------------
out/
cache/
cache_forge/
broadcast/
artifacts/
typechain-types/
coverage/
*.lcov
.next/
dist/
.turbo/

# ---------------------------------------------------------------------------
# Vendored research inputs. Public and reproducible -- see engineering/README.md
# for the exact commands. Not vendored because botkit/ carries its own .git and
# sdkprobe/ is ~92MB of node_modules.
# ---------------------------------------------------------------------------
botkit/
sdkprobe/
recon/

