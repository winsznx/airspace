# ---------------------------------------------------------------------------
# Secrets and local state -- NEVER commit.
# Note: `.env` alone is not enough; the research pass used .env.fork/.env.airspace/
# .env.lock, so the glob is mandatory.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.wallets.json
wallets.json
*.key
*.pem
*.p12
*.keystore
keystore/
mnemonic*
secrets*
*.secret
service-role*
.secrets/

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
/lib/

