# AIRSPACE environment variables.
# Copy to .env.local (gitignored) and fill in. NEVER commit a filled copy.

# --- Chain -----------------------------------------------------------------
SHANNON_RPC=https://dream-rpc.somnia.network
SHANNON_RPC_FALLBACK=https://rpc.ankr.com/somnia_testnet
CHAIN_ID=50312

# --- Deployed AIRSPACE contracts (public; filled by scripts/deploy) ---------
AIRSPACE_FACTORY=

# --- Supabase --------------------------------------------------------------
# URL, project ref and the publishable/anon key are public.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# SECRET. Worker/CI secret only. Never in a browser bundle or an API response.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Only needed for `supabase db push`.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# --- Wallet ----------------------------------------------------------------
# WalletConnect project id, from https://cloud.reown.com — free.
# PUBLIC: it ships in the browser bundle and identifies the dApp to the relay.
# It authorises nothing, so it is safe to commit. Without it the app still runs
# but lists browser wallets only: there is no QR flow, so no phone can connect.
# Read at BUILD time by Vite, so it must be set before `pnpm build`.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Cloudflare ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# SECRET. CI only; local development uses `wrangler login`.
CLOUDFLARE_API_TOKEN=

# --- Keys ------------------------------------------------------------------
# SECRET. Throwaway testnet keys for the live proof and the sample agents live
# in .wallets.json (gitignored) or in Cloudflare Worker secrets. Never here.
